{
  "name": "单选",
  "label": "单选",
  "order": 80,
  "dataType": {
    "type": "${ dataType }",
    "size": "${size}"
  },
  "ui": {
    "input": {
      "type": "radios",
      "options": "${options}"
    },
    "display": {
      "type": "radios",
      "static": true,
      "options": "${options}"
    }
  },
  "validations": {},
  "paramsUiSchema": [
    {
      "type": "button-group-select",
      "name": "dataType",
      "value": "String",
      "options": [
        {
          "value": "String",
          "label": "字符串"
        },
        {
          "value": "Short",
          "label": "短整型"
        },
        {
          "value": "Integer",
          "label": "整型"
        },
        {
          "value": "Long",
          "label": "长整型"
        }
      ]
    },
    {
      "type": "input-number",
      "name": "size",
      "label": "长度",
      "value": 100,
      "visibleOn": "${ dataType === 'String' }"
    },
    {
      "type": "combo",
      "name": "options",
      "label": "选项",
      "multiple": true,
      "strictMode": false,
      "items": [
        {
          "type": "input-text",
          "name": "value",
          "visibleOn": "${ dataType === 'String' }",
          "placeholder": "值",
          "required": true,
          "unique": true
        },
        {
          "type": "input-number",
          "name": "value",
          "hiddenOn": "${ dataType === 'String' }",
          "placeholder": "值",
          "required": true,
          "unique": true
        },
        {
          "type": "input-text",
          "name": "label",
          "placeholder": "显示文本",
          "required": true,
          "unique": true
        }
      ]
    }
  ]
}
